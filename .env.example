# ==========================================
# NewsFlow AI — Entorno de Configuración
# ==========================================

# Entorno y Zona Horaria
NODE_ENV=production
TZ=America/Bogota
DEFAULT_TIMEZONE=America/Bogota

# URLs Públicas de Despliegue en Coolify
APP_URL=https://face.appzplay.online
API_URL=https://face.appzplay.online/api
PORT=3000

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://newsflow_user:newsflow_secure_password@postgres:5432/newsflow_db?schema=public

# Redis Broker (BullMQ y Caching)
REDIS_URL=redis://:redis_secure_password@redis:6379

# Seguridad y Cifrado
# Cadena aleatoria de 64 caracteres para sesiones y JWT
SESSION_SECRET=reemplazar_con_cadena_aleatoria_64_chars_segura_aqui_generada_con_openssl
# Clave simétrica de 32 bytes en formato HEX (64 caracteres) para AES-256-GCM
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta Graph API (Facebook Login & Páginas)
META_APP_ID=tu_meta_app_id_aqui
META_APP_SECRET=tu_meta_app_secret_aqui
META_REDIRECT_URI=https://face.appzplay.online/api/meta/connect/callback
META_GRAPH_API_VERSION=v19.0

# Google Cloud OAuth & YouTube Data API v3 (Subida Automática de Shorts)
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_REDIRECT_URI=https://face.appzplay.online/api/youtube/callback

# Proveedor de Inteligencia Artificial (openai | anthropic | gemini)
LLM_PROVIDER=openai
LLM_API_KEY=sk-tu-api-key-de-ia-aqui
LLM_MODEL=gpt-4o-mini

# Políticas de Publicación
# Por defecto FALSE por seguridad editorial. Solo activar tras validar en staging.
AUTO_PUBLISH_ENABLED=false
MAX_POSTS_PER_DAY=3

# Almacenamiento S3 (Opcional - para medios persistentes)
S3_ENDPOINT=
S3_BUCKET=newsflow-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
